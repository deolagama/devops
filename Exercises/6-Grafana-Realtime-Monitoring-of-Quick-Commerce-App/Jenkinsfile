pipeline {
    agent any

    stages {
        stage('Check Docker') {
            steps {
                sh 'docker --version'
                sh 'docker ps'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Exercises/6-Grafana-Realtime-Monitoring-of-Quick-Commerce-App') {
                    sh 'docker build -t delivery_metrics .'
                }
            }
        }

        stage('Run Container') {
            steps {
                sh 'docker rm -f delivery_metrics || true'
                sh 'docker run -d --name delivery_metrics -p 8000:8000 delivery_metrics'
            }
        }
    }
}
